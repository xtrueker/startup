# ============================================================================
# RED CIUDADANA — CONFIGURACIÓN SERVIDOR CENTRAL (apps/api)
# ============================================================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001

# Seguridad Criptográfica & Bóveda AES-256-GCM (Ley 1581 Habeas Data)
JWT_SECRET=reemplazar_por_secreto_aleatorio_minimo_32_caracteres
VAULT_ENCRYPTION_KEY=reemplazar_por_llave_maestra_aes256_independiente

# Base de Datos Única (Supabase PostgreSQL)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_anon_o_service_role_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_recomendado_en_produccion
DATABASE_URL=postgresql://postgres:password@db.tu-proyecto.supabase.co:5432/postgres

# Biometría Facial Real en la Nube (Opcional — AWS Rekognition CompareFaces)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Despacho Automático por WhatsApp (Opcional — Meta Cloud API v21.0 o Webhook n8n/Evolution)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DISPATCH_RECIPIENTS=573001234567,573109876543
WHATSAPP_WEBHOOK_URL=

# Escalabilidad Horizontal Socket.IO (Opcional)
REDIS_URL=
