# ============================================================================
# RED CIUDADANA — CONFIGURACIÓN APP MÓVIL & EXPO WEB (apps/mobile)
# ============================================================================
# En producción / staging (EAS Build), define aquí tu dominio HTTPS real:
# EXPO_PUBLIC_API_URL=https://api.redciudadana.co
# EXPO_PUBLIC_SOCKET_URL=https://api.redciudadana.co
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SOCKET_URL=

# Desarrollo LAN opcional (se autodetecta desde Metro si se deja vacío):
EXPO_PUBLIC_DEV_HOST=
EXPO_PUBLIC_API_PORT=3001

# Región inicial del mapa y contingencia GPS (Opcional):
EXPO_PUBLIC_DEFAULT_LAT=7.0653
EXPO_PUBLIC_DEFAULT_LNG=-73.8547

# Mapas nativos / tiles y cuenta demo en Login (Opcional):
EXPO_PUBLIC_USE_NATIVE_MAPS=false
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_ENABLE_DEMO=true
EXPO_PUBLIC_DEMO_EMAIL=demo@redciudadana.org
EXPO_PUBLIC_DEMO_PASSWORD=password123
